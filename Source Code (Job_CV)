\section{Selected Projects}

\textbf{Enhancing Genre Fidelity in Children’s Story Generation via Fine-Tuned LLMs}
\begin{onecolentry}
\begin{highlights}
\item Designed a genre-conditioned story generation framework using LLaMA-2 (7B) fine-tuned with PEFT-LoRA.
\item Evaluated genre adherence using a transformer-based classifier achieving 97.56\% accuracy.
\item Tools: Python, HuggingFace Transformers, Scikit-learn, Google Colab
\end{highlights}
\end{onecolentry}

